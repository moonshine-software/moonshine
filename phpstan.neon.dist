includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    configDirectories:
        - src/Laravel/config
    stubFiles:
        - phpstan/helpers.stub
    bootstrapFiles:
        - phpstan/bootstrap.php
    editorUrl: 'anything'
    paths:
        - src/
        - phpstan/traits.php
    level: max
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
